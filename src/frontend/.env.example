# The web app needs no settings for local development. To change these,
# copy this file to .env.local and uncomment the lines.

# Where the Sparks API runs. The web app's server calls it directly; the
# browser reaches it through this app's /api/v1, /files and /hubs rewrites,
# so it never makes a cross-origin call.
# API_URL=http://localhost:5100

# Where people reach this app. Link previews (Open Graph images) need
# absolute URLs, so set it to the public address when deploying.
# SITE_URL=http://localhost:3100
