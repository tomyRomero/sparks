{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "BaseUrl": "http://localhost:3100"
  },
  "Storage": {
    "Provider": "S3",
    "LocalRoot": "App_Data/files"
  },
  "Ai": {
    "TextProvider": "Sample",
    "ImageProvider": "Sample"
  }
}
